{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetcup-pit2",
  "main": "backend/entry.py",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sweetcup-pit2", "database_id": "00000000-0000-0000-0000-000000000001" }]
}
