{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetcupcrazy",
  "main": "backend/entry.py",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "python_workers",
    "disable_python_external_sdk"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sweetcup-pit2",
      "database_id": "c388a639-0635-4703-a9fa-32e2d095da0e"
    }
  ],
  "account_id": "d0360f247511c9fa480356445052e03e",
  "workers_dev": true
}
